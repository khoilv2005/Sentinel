# SentinelView development/lab environment template
# Copy to .env and replace every change-me value before non-lab use.

POSTGRES_DB=sentinel
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=change-this-database-password
SENTINEL_DB_URL=postgresql+psycopg://sentinel:change-this-database-password@postgres:5432/sentinel

SENTINEL_API_KEY=change-this-api-key
SENTINEL_LOG_LEVEL=INFO
SENTINEL_SCAN_MAX_HOSTS=4096
SENTINEL_AGENT_ONLINE_SECONDS=120
SENTINEL_PROMETHEUS_URL=http://prometheus:9090

SENTINEL_ADMIN_USER=admin
SENTINEL_ADMIN_PASSWORD=change-this-admin-password
SENTINEL_SESSION_SECRET=change-this-session-secret
SENTINEL_SESSION_HOURS=12
SENTINEL_CREDENTIAL_SECRET=change-this-credential-secret

SENTINEL_COLLECTOR_WORKERS=24
SENTINEL_NOTIFICATION_POLL_SECONDS=2
SENTINEL_NOTIFICATION_BATCH_SIZE=100

GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change-this-grafana-password
GF_USERS_ALLOW_SIGN_UP=false
