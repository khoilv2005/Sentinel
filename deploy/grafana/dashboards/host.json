        "w": 8,
        "x": 8,
        "y": 0
      },
      "targets": [
        {
          "expr": "sentinel_memory_usage_percent{hostname=\"$host\"}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
