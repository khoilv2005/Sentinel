{
  "editable": true,
  "panels": [
    {
      "type": "stat",
      "title": "CPU",
      "id": 1,
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "sentinel_cpu_usage_percent{hostname=\"$host\"}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Memory",
      "id": 2,
      "gridPos": {
