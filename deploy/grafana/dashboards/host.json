  "refresh": "15s",
  "schemaVersion": 41,
  "tags": [
    "sentinelview",
    "host"
  ],
  "templating": {
    "list": [
      {
        "name": "host",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(sentinel_agent_up, hostname)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 1,
        "multi": false,
        "includeAll": false
      }
    ]
  },
  "time": {
    "from": "now-6h",
    "to": "now"
